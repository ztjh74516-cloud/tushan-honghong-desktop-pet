<Window x:Class="TushanHonghong.DesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="192"
        Height="208"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Background="Transparent">
        <Image x:Name="PetImage" Stretch="None" SnapsToDevicePixels="True" />
    </Grid>
</Window>

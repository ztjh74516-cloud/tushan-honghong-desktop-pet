<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\base\spritesheet.webp" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\base\animations.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
